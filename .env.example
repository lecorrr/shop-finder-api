# Local settings. Create your .env from this file with:  python3 scripts/make_env.py
# Commands run on your machine (manage.py, pytest) use these URLs to reach the Compose
# services; inside Compose the hosts are replaced by service names (see compose.yaml).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_COOKIES=false

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://shopfinder:change-me@127.0.0.1:5435/shopfinder
MONGO_URL=mongodb://127.0.0.1:27018
MONGO_DB=shopfinder
REDIS_URL=redis://127.0.0.1:6380/0
CACHE_URL=rediscache://127.0.0.1:6380/1

WEB_CONCURRENCY=2
LOG_LEVEL=INFO
